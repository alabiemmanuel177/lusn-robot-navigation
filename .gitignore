# Top-level colcon artefacts (the ros_ws/ copies were already ignored)
/.venv_ocr_probe/
/build/
/install/
/log/

# Large capture media, archives and transient state stay out of version control.
# Small JSON/YAML/MD provenance under reports/ is tracked; media is hash-pinned there.
reports/landmark_capture/
reports/physical_live_episodes/
reports/*.tar.gz
reports/*.zip
reports/.research3_physical_execution.lock
.agents/
.codex/

# Rendered diagnostic packet images are hash-pinned in their manifest.json; keep the bytes out of git.
reports/expansion_diagnostic_asset_review_*/images/
reports/expansion_chain_20260914/chain.log

# Review kit archives are hash-pinned in their packet metadata; keep the bytes out of git.
reports/expansion_review_*/*.zip

# Four-class development evidence: retain small provenance, not large raw media.
reports/four_class_*/**/*.bin
reports/four_class_*/*.npz
reports/four_class_*/**/logs/
reports/four_class_*_preview_*/*.png

# Raw capture media, frames, logs and review kit contents stay out of version control
**/*.bin
**/*.npz
**/ros_logs/
reports/**/*.log
reports/expansion_collection_*/*.log
reports/joint_score_wave_s_primary_*/
reports/joint_score_wave_s_human_review_*/
