{
  "$id": "https://local.protocol/risk-calibrated-nav/landmark-scene-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "category": {
            "enum": [
              "chair",
              "door",
              "doorway",
              "glass_doors",
              "sign",
              "laboratory_entrance",
              "office_entrance"
            ]
          },
          "covariance": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "entity_id": {
            "minLength": 1,
            "type": "string"
          },
          "marker_rgb": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "pose": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "yaw": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "yaw"
            ],
            "type": "object"
          },
          "region_id": {
            "minLength": 1,
            "type": "string"
          },
          "route_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "entity_id",
          "region_id",
          "category",
          "attributes",
          "pose",
          "covariance",
          "marker_rgb",
          "route_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "map_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "map_id": {
      "pattern": "^test_[0-9]{2}$",
      "type": "string"
    },
    "partition": {
      "enum": [
        "test"
      ]
    },
    "schema_version": {
      "const": "landmark-scene/v1"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "map_id",
    "partition",
    "map_hash",
    "source",
    "entities"
  ],
  "title": "Explicitly authorized held-out landmark scene extension",
  "type": "object"
}
