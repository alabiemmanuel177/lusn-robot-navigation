<?xml version="1.0" encoding="UTF-8"?>
<!-- Host-local unicast discovery, aligned with the completed Research 1 platform. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface address="127.0.0.1" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <FragmentSize>60000B</FragmentSize>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="10MB" max="10MB"/>
      <SocketSendBufferSize min="10MB" max="10MB"/>
      <MaxSampleSize>16MB</MaxSampleSize>
    </Internal>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
